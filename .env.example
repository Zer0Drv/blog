# blog 后端环境变量样例：cp .env.example .env 后填写。
# docker compose 自动读取本文件；直接 mvn spring-boot:run 时请自行 export。
# 注意：.env 已在 .gitignore 中（*.env 类文件不得入库），口令/密钥绝不提交仓库。

# ---------- 数据库 ----------
DB_HOST=localhost
DB_PORT=3307
DB_NAME=blog_dev
DB_USERNAME=root
# 必填：MySQL root 口令（同时被 docker-compose 的 MYSQL_ROOT_PASSWORD 消费）
DB_PASSWORD=

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------- JWT（必填，#2 fail-fast） ----------
# 强随机密钥，HS256 要求 ≥32 字节；生成：openssl rand -base64 48
JWT_SECRET=

# ---------- MinIO ----------
MINIO_ENABLED=true
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ACCESS_KEY=
# 必填：MinIO root 口令（同时被 docker-compose 的 MINIO_ROOT_PASSWORD 消费）
MINIO_SECRET_KEY=
MINIO_BUCKET=blog-images

# ---------- 初始管理员（可选，#2） ----------
# 库内无 ADMIN（或 admin 仍为已泄露的历史种子口令）时启动期重建/轮换：
# 设置了则用该口令；留空则随机生成并仅打印一次到启动日志，首登后请立即修改。
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=

# ---------- GitHub OAuth ----------
# 注意：这两项**不要留空赋值**（GITHUB_CLIENT_ID=）。空值会覆盖 application-dev.yaml 的
# `replace-me` 占位，导致启动直接失败：
#   Client id of registration 'github' must not be empty.
# 本地不接 OAuth 时保持注释即可（走 yaml 占位值）；接入时再填真实凭据。
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# OAUTH_SUCCESS_REDIRECT=http://localhost:5173/oauth/callback
# OAUTH_FAILURE_REDIRECT=http://localhost:5173/login?error=oauth_failed

# ---------- 认证 Cookie（blog-ui#13，一般无需改） ----------
# AUTH_COOKIE_NAME=AUTH_TOKEN
# AUTH_COOKIE_SAME_SITE=Strict   # 前后端跨站点部署时置 None（必须 HTTPS）
# AUTH_COOKIE_SECURE=true        # 生产必须 true

# ---------- 安全开关（一般无需改） ----------
# TRUST_PROXY_HEADERS=false      # 仅部署在可信反向代理后时置 true
# CSRF_HEADER_CHECK_ENABLED=true
# UPLOAD_DAILY_LIMIT=100

# ---------- 邮件（可选） ----------
# 配置后验证码/通知走真实邮件，同时需取消 application-dev.yaml 中 spring.mail.* 注释
# MAIL_USERNAME=
# MAIL_PASSWORD=
